:root{
  --bg-0:#0e0f13;
  --bg-1:#16181f;
  --bg-2:#1e212b;
  --bg-3:#272b38;
  --line:#333a4a;
  --text-hi:#f2f3f7;
  --text-lo:#9096a8;
  --accent:#ff3e7f;
  --accent-2:#6c5ce7;
  --accent-grad:linear-gradient(135deg,#ff3e7f 0%,#6c5ce7 100%);
  font-family:'Segoe UI', Arial, sans-serif;
}

*{
  box-sizing:border-box;
}

html, body{
  margin:0;
  padding:0;
  height:100%;
  background:var(--bg-0);
  color:var(--text-hi);
}

.app{
  display:flex;
  flex-direction:column;
  height:100vh;
  max-width:760px;
  margin:0 auto;
  background:var(--bg-1);
  border-left:1px solid var(--line);
  border-right:1px solid var(--line);
}

/* ========================= HEADER ========================= */

header{
  flex-shrink:0;
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 18px;
  background:var(--bg-1);
  border-bottom:1px solid var(--line);
}

header h1{
  margin:0;
  font-size:19px;
  font-weight:800;
  background:var(--accent-grad);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

header p{
  margin:0;
  font-size:12px;
  color:var(--text-lo);
  flex:1;
}

header button{
  background:var(--accent-grad);
  border:none;
  color:#fff;
  font-weight:600;
  font-size:13px;
  padding:8px 14px;
  border-radius:8px;
  cursor:pointer;
  transition:transform .12s ease, box-shadow .12s ease;
  box-shadow:0 4px 14px rgba(255,62,127,0.25);
}

header button:hover{
  transform:translateY(-1px);
  box-shadow:0 6px 18px rgba(255,62,127,0.4);
}

/* ========================= CHAT BOX ========================= */

.chat-box{
  flex:1;
  overflow-y:auto;
  padding:18px;
  display:flex;
  flex-direction:column;
  gap:12px;
  background:var(--bg-0);
}

.chat-box::-webkit-scrollbar{
  width:8px;
}

.chat-box::-webkit-scrollbar-thumb{
  background:var(--bg-3);
  border-radius:4px;
}

.bubble{
  max-width:78%;
  padding:11px 15px;
  border-radius:14px;
  font-size:14px;
  line-height:1.5;
  word-wrap:break-word;
  white-space:pre-wrap;
}

.bubble.ai{
  align-self:flex-start;
  background:var(--bg-2);
  border:1px solid var(--line);
  color:var(--text-hi);
  border-bottom-left-radius:4px;
}

.bubble.user{
  align-self:flex-end;
  background:var(--accent-grad);
  color:#fff;
  border-bottom-right-radius:4px;
}

.bubble.typing{
  align-self:flex-start;
  background:var(--bg-2);
  border:1px solid var(--line);
  color:var(--text-lo);
  font-style:italic;
}

/* ========================= INPUT AREA ========================= */

.input-area{
  flex-shrink:0;
  display:flex;
  align-items:center;
  gap:8px;
  padding:14px 18px;
  background:var(--bg-1);
  border-top:1px solid var(--line);
}

.input-area input{
  flex:1;
  background:var(--bg-2);
  border:1px solid var(--line);
  color:var(--text-hi);
  font-size:14px;
  padding:11px 14px;
  border-radius:24px;
  outline:none;
  transition:border-color .15s ease;
}

.input-area input:focus{
  border-color:var(--accent-2);
}

.input-area input::placeholder{
  color:var(--text-lo);
}

.input-area button{
  flex-shrink:0;
  border:none;
  cursor:pointer;
  font-size:14px;
  font-weight:600;
  border-radius:24px;
  padding:11px 18px;
  transition:transform .12s ease, opacity .12s ease;
}

.input-area button:hover{
  transform:translateY(-1px);
}

#sendBtn{
  background:var(--accent-grad);
  color:#fff;
}

#voiceBtn{
  background:var(--bg-2);
  border:1px solid var(--line);
  color:var(--text-hi);
  padding:11px 14px;
}

#voiceBtn.recording{
  background:var(--accent);
  border-color:var(--accent);
  animation:pulse 1s infinite;
}

@keyframes pulse{
  0%{ box-shadow:0 0 0 0 rgba(255,62,127,0.5); }
  70%{ box-shadow:0 0 0 10px rgba(255,62,127,0); }
  100%{ box-shadow:0 0 0 0 rgba(255,62,127,0); }
}

/* ========================= RESPONSIVE ========================= */

@media (max-width: 600px){
  .app{
    max-width:100%;
    border-left:none;
    border-right:none;
  }
  .bubble{
    max-width:88%;
  }
}

